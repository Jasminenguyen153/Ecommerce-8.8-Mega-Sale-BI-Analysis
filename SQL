/*====================================================================
 PART 1: CREATE DATABASE
====================================================================*/

CREATE DATABASE Ecommerce;
GO

USE Ecommerce;
GO


/*====================================================================
 PART 2: CREATE TABLES
====================================================================*/


/*--------------------------------------------------------------------
 1. Categories
--------------------------------------------------------------------*/

CREATE TABLE Categories
(
    CategoryID INT NOT NULL,
    CategoryName NVARCHAR(100) NOT NULL,

    CONSTRAINT PK_Categories
        PRIMARY KEY (CategoryID),

    CONSTRAINT UQ_Categories_CategoryName
        UNIQUE (CategoryName)
);
GO


/*--------------------------------------------------------------------
 2. Products
--------------------------------------------------------------------*/

CREATE TABLE Products
(
    ProductID INT NOT NULL,
    CategoryID INT NOT NULL,
    ProductName NVARCHAR(150) NOT NULL,
    BrandName NVARCHAR(100) NOT NULL,
    CostPrice DECIMAL(12,2) NOT NULL,
    RegularPrice DECIMAL(12,2) NOT NULL,

    CONSTRAINT PK_Products
        PRIMARY KEY (ProductID),

    CONSTRAINT FK_Products_Categories
        FOREIGN KEY (CategoryID)
        REFERENCES Categories(CategoryID),

    CONSTRAINT CK_Products_CostPrice
        CHECK (CostPrice >= 0),

    CONSTRAINT CK_Products_RegularPrice
        CHECK (RegularPrice > 0)
);
GO


/*--------------------------------------------------------------------
 3. Customers
--------------------------------------------------------------------*/

CREATE TABLE Customers
(
    CustomerID INT NOT NULL,
    CustomerName NVARCHAR(100) NOT NULL,
    Gender NVARCHAR(20) NULL,
    StateName NVARCHAR(100) NOT NULL,
    CustomerSegment NVARCHAR(30) NOT NULL,
    RegisterDate DATE NOT NULL,

    CONSTRAINT PK_Customers
        PRIMARY KEY (CustomerID),

    CONSTRAINT CK_Customers_Segment
        CHECK (CustomerSegment IN (N'New', N'Regular', N'VIP'))
);
GO


/*--------------------------------------------------------------------
 4. Channels
--------------------------------------------------------------------*/

CREATE TABLE Channels
(
    ChannelID INT NOT NULL,
    ChannelName NVARCHAR(100) NOT NULL,
    CommissionRate DECIMAL(5,2) NOT NULL,

    CONSTRAINT PK_Channels
        PRIMARY KEY (ChannelID),

    CONSTRAINT UQ_Channels_ChannelName
        UNIQUE (ChannelName),

    CONSTRAINT CK_Channels_CommissionRate
        CHECK (CommissionRate BETWEEN 0 AND 100)
);
GO


/*--------------------------------------------------------------------
 5. Campaigns
--------------------------------------------------------------------*/

CREATE TABLE Campaigns
(
    CampaignID INT NOT NULL,
    CampaignName NVARCHAR(150) NOT NULL,
    StartDate DATE NOT NULL,
    EndDate DATE NOT NULL,
    Objective NVARCHAR(300) NULL,
    PlannedBudget DECIMAL(14,2) NOT NULL,

    CONSTRAINT PK_Campaigns
        PRIMARY KEY (CampaignID),

    CONSTRAINT CK_Campaigns_DateRange
        CHECK (EndDate >= StartDate),

    CONSTRAINT CK_Campaigns_PlannedBudget
        CHECK (PlannedBudget >= 0)
);
GO


/*--------------------------------------------------------------------
 6. Promotions

 CustomerDiscountPercent:
     Discount visible to the customer.

 PlatformSubsidyPercent:
     Portion of the discount reimbursed by Shopee/TikTok.
     Example:
       Customer discount = 50%
       Platform subsidy = 30%
       Seller effectively absorbs 20%.
--------------------------------------------------------------------*/

CREATE TABLE Promotions
(
    PromotionID INT NOT NULL,
    CampaignID INT NOT NULL,
    PromotionName NVARCHAR(150) NOT NULL,
    PromotionType NVARCHAR(50) NOT NULL,
    CustomerDiscountPercent DECIMAL(5,2) NOT NULL,
    PlatformSubsidyPercent DECIMAL(5,2) NOT NULL,
    GiftName NVARCHAR(150) NULL,
    GiftUnitCost DECIMAL(12,2) NOT NULL
        CONSTRAINT DF_Promotions_GiftUnitCost DEFAULT 0,
    StartDate DATE NOT NULL,
    EndDate DATE NOT NULL,

    CONSTRAINT PK_Promotions
        PRIMARY KEY (PromotionID),

    CONSTRAINT FK_Promotions_Campaigns
        FOREIGN KEY (CampaignID)
        REFERENCES Campaigns(CampaignID),

    CONSTRAINT CK_Promotions_CustomerDiscount
        CHECK (CustomerDiscountPercent BETWEEN 0 AND 100),

    CONSTRAINT CK_Promotions_PlatformSubsidy
        CHECK
        (
            PlatformSubsidyPercent BETWEEN 0 AND 100
            AND PlatformSubsidyPercent <= CustomerDiscountPercent
        ),

    CONSTRAINT CK_Promotions_GiftUnitCost
        CHECK (GiftUnitCost >= 0),

    CONSTRAINT CK_Promotions_DateRange
        CHECK (EndDate >= StartDate)
);
GO


/*--------------------------------------------------------------------
 7. Livestreams

 One host appears on both Shopee and TikTok Shop during the
 same time window on each campaign day.
--------------------------------------------------------------------*/

CREATE TABLE Livestreams
(
    LivestreamID INT NOT NULL,
    CampaignID INT NOT NULL,
    ChannelID INT NOT NULL,
    HostName NVARCHAR(100) NOT NULL,
    LiveDate DATE NOT NULL,
    StartTime TIME NOT NULL,
    EndTime TIME NOT NULL,
    TotalViews INT NOT NULL,
    TotalClicks INT NOT NULL,
    LivestreamCost DECIMAL(12,2) NOT NULL,

    CONSTRAINT PK_Livestreams
        PRIMARY KEY (LivestreamID),

    CONSTRAINT FK_Livestreams_Campaigns
        FOREIGN KEY (CampaignID)
        REFERENCES Campaigns(CampaignID),

    CONSTRAINT FK_Livestreams_Channels
        FOREIGN KEY (ChannelID)
        REFERENCES Channels(ChannelID),

    CONSTRAINT CK_Livestreams_TimeRange
        CHECK (EndTime > StartTime),

    CONSTRAINT CK_Livestreams_TotalViews
        CHECK (TotalViews >= 0),

    CONSTRAINT CK_Livestreams_TotalClicks
        CHECK (TotalClicks >= 0),

    CONSTRAINT CK_Livestreams_Cost
        CHECK (LivestreamCost >= 0)
);
GO


/*--------------------------------------------------------------------
 8. CampaignCosts

 ChannelID:
   NULL = shared campaign cost
   1    = Shopee-specific cost
   2    = TikTok Shop-specific cost

 This design makes channel ROI more defensible because direct channel
 costs are assigned directly and only shared costs require allocation.
--------------------------------------------------------------------*/

CREATE TABLE CampaignCosts
(
    CampaignCostID INT NOT NULL,
    CampaignID INT NOT NULL,
    ChannelID INT NULL,
    CostType NVARCHAR(100) NOT NULL,
    CostDescription NVARCHAR(250) NULL,
    Amount DECIMAL(14,2) NOT NULL,

    CONSTRAINT PK_CampaignCosts
        PRIMARY KEY (CampaignCostID),

    CONSTRAINT FK_CampaignCosts_Campaigns
        FOREIGN KEY (CampaignID)
        REFERENCES Campaigns(CampaignID),

    CONSTRAINT FK_CampaignCosts_Channels
        FOREIGN KEY (ChannelID)
        REFERENCES Channels(ChannelID),

    CONSTRAINT CK_CampaignCosts_Amount
        CHECK (Amount >= 0)
);
GO


/*--------------------------------------------------------------------
 9. Orders

 Promotion is NOT stored at order level because promotions are applied
 to individual products. PromotionID is stored in OrderDetails.
--------------------------------------------------------------------*/

CREATE TABLE Orders
(
    OrderID INT NOT NULL,
    CustomerID INT NOT NULL,
    ChannelID INT NOT NULL,
    CampaignID INT NOT NULL,
    LivestreamID INT NULL,
    OrderDateTime DATETIME2(0) NOT NULL,
    OrderStatus NVARCHAR(30) NOT NULL,
    PaymentMethod NVARCHAR(50) NOT NULL,
    ShippingFeePaidByCustomer DECIMAL(12,2) NOT NULL,
    ShippingSubsidy DECIMAL(12,2) NOT NULL,
    PlatformFee DECIMAL(12,2) NOT NULL,

    CONSTRAINT PK_Orders
        PRIMARY KEY (OrderID),

    CONSTRAINT FK_Orders_Customers
        FOREIGN KEY (CustomerID)
        REFERENCES Customers(CustomerID),

    CONSTRAINT FK_Orders_Channels
        FOREIGN KEY (ChannelID)
        REFERENCES Channels(ChannelID),

    CONSTRAINT FK_Orders_Campaigns
        FOREIGN KEY (CampaignID)
        REFERENCES Campaigns(CampaignID),

    CONSTRAINT FK_Orders_Livestreams
        FOREIGN KEY (LivestreamID)
        REFERENCES Livestreams(LivestreamID),

    CONSTRAINT CK_Orders_Status
        CHECK (OrderStatus IN (N'Completed', N'Cancelled', N'Returned')),

    CONSTRAINT CK_Orders_ShippingFee
        CHECK (ShippingFeePaidByCustomer >= 0),

    CONSTRAINT CK_Orders_ShippingSubsidy
        CHECK (ShippingSubsidy >= 0),

    CONSTRAINT CK_Orders_PlatformFee
        CHECK (PlatformFee >= 0)
);
GO


/*--------------------------------------------------------------------
 10. OrderDetails

 CustomerDiscountAmount:
     Total discount seen by the customer.

 PlatformSubsidyAmount:
     Reimbursement paid by the marketplace to the seller.

 Net product revenue to the company:
     Quantity * UnitPrice
     - CustomerDiscountAmount
     + PlatformSubsidyAmount
--------------------------------------------------------------------*/

CREATE TABLE OrderDetails
(
    OrderDetailID INT IDENTITY(1,1) NOT NULL,
    OrderID INT NOT NULL,
    ProductID INT NOT NULL,
    PromotionID INT NULL,
    Quantity INT NOT NULL,
    UnitPrice DECIMAL(12,2) NOT NULL,
    CustomerDiscountAmount DECIMAL(12,2) NOT NULL,
    PlatformSubsidyAmount DECIMAL(12,2) NOT NULL,
    CostOfGoodsSold DECIMAL(12,2) NOT NULL,
    GiftCost DECIMAL(12,2) NOT NULL,

    CONSTRAINT PK_OrderDetails
        PRIMARY KEY (OrderDetailID),

    CONSTRAINT FK_OrderDetails_Orders
        FOREIGN KEY (OrderID)
        REFERENCES Orders(OrderID),

    CONSTRAINT FK_OrderDetails_Products
        FOREIGN KEY (ProductID)
        REFERENCES Products(ProductID),

    CONSTRAINT FK_OrderDetails_Promotions
        FOREIGN KEY (PromotionID)
        REFERENCES Promotions(PromotionID),

    CONSTRAINT CK_OrderDetails_Quantity
        CHECK (Quantity > 0),

    CONSTRAINT CK_OrderDetails_UnitPrice
        CHECK (UnitPrice > 0),

    CONSTRAINT CK_OrderDetails_CustomerDiscount
        CHECK (CustomerDiscountAmount >= 0),

    CONSTRAINT CK_OrderDetails_PlatformSubsidy
        CHECK (PlatformSubsidyAmount >= 0),

    CONSTRAINT CK_OrderDetails_COGS
        CHECK (CostOfGoodsSold >= 0),

    CONSTRAINT CK_OrderDetails_GiftCost
        CHECK (GiftCost >= 0)
);
GO


