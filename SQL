/*====================================================================
 PART 9: BI ANALYSIS QUERIES
 Only COMPLETED orders are included in sales/profit analysis.
====================================================================*/


/*====================================================================
 QUERY 1: TOP 10 BEST-SELLING PRODUCTS
====================================================================*/

SELECT TOP 10
    P.ProductID,
    P.ProductName,
    P.BrandName,
    C.CategoryName,

    SUM(OD.Quantity) AS TotalUnitsSold,

    COUNT(DISTINCT O.OrderID) AS TotalOrders,

    CAST
    (
        SUM
        (
            OD.Quantity * OD.UnitPrice
            - OD.CustomerDiscountAmount
            + OD.PlatformSubsidyAmount
        )
        AS DECIMAL(14,2)
    ) AS NetRevenue

FROM OrderDetails OD

INNER JOIN Orders O
    ON OD.OrderID = O.OrderID

INNER JOIN Products P
    ON OD.ProductID = P.ProductID

INNER JOIN Categories C
    ON P.CategoryID = C.CategoryID

WHERE O.OrderStatus = N'Completed'
  AND O.CampaignID = 1

GROUP BY
    P.ProductID,
    P.ProductName,
    P.BrandName,
    C.CategoryName

ORDER BY
    TotalUnitsSold DESC,
    NetRevenue DESC;
GO


/*====================================================================
 QUERY 2: DAILY CAMPAIGN REVENUE
====================================================================*/

WITH OrderRevenue AS
(
    SELECT
        O.OrderID,
        CAST(O.OrderDateTime AS DATE) AS SalesDate,

        SUM(OD.Quantity) AS TotalUnitsSold,

        SUM
        (
            OD.Quantity * OD.UnitPrice
            - OD.CustomerDiscountAmount
            + OD.PlatformSubsidyAmount
        ) AS ProductNetRevenue,

        O.ShippingFeePaidByCustomer

    FROM Orders O

    INNER JOIN OrderDetails OD
        ON O.OrderID = OD.OrderID

    WHERE O.OrderStatus = N'Completed'
      AND O.CampaignID = 1

    GROUP BY
        O.OrderID,
        CAST(O.OrderDateTime AS DATE),
        O.ShippingFeePaidByCustomer
)

SELECT
    SalesDate,

    COUNT(*) AS TotalOrders,

    SUM(TotalUnitsSold) AS TotalUnitsSold,

    CAST
    (
        SUM(ProductNetRevenue)
        AS DECIMAL(14,2)
    ) AS ProductNetRevenue,

    CAST
    (
        SUM(ProductNetRevenue + ShippingFeePaidByCustomer)
        AS DECIMAL(14,2)
    ) AS TotalRevenue

FROM OrderRevenue

GROUP BY SalesDate

ORDER BY SalesDate;
GO


/*====================================================================
 QUERY 3: SHOPEE VS. TIKTOK SHOP
====================================================================*/

WITH ChannelOrders AS
(
    SELECT
        O.OrderID,
        O.ChannelID,

        SUM
        (
            OD.Quantity * OD.UnitPrice
            - OD.CustomerDiscountAmount
            + OD.PlatformSubsidyAmount
        ) AS ProductNetRevenue,

        SUM(OD.CostOfGoodsSold) AS COGS,

        SUM(OD.GiftCost) AS GiftCost,

        O.PlatformFee,
        O.ShippingSubsidy,
        O.ShippingFeePaidByCustomer

    FROM Orders O

    INNER JOIN OrderDetails OD
        ON O.OrderID = OD.OrderID

    WHERE O.OrderStatus = N'Completed'
      AND O.CampaignID = 1

    GROUP BY
        O.OrderID,
        O.ChannelID,
        O.PlatformFee,
        O.ShippingSubsidy,
        O.ShippingFeePaidByCustomer
)

SELECT
    C.ChannelName,

    COUNT(*) AS TotalOrders,

    CAST
    (
        SUM(CO.ProductNetRevenue)
        AS DECIMAL(14,2)
    ) AS ProductNetRevenue,

    CAST
    (
        AVG(CO.ProductNetRevenue)
        AS DECIMAL(14,2)
    ) AS AverageOrderValue,

    CAST
    (
        SUM
        (
            CO.ProductNetRevenue
            + CO.ShippingFeePaidByCustomer
            - CO.COGS
            - CO.GiftCost
            - CO.PlatformFee
            - CO.ShippingSubsidy
        )
        AS DECIMAL(14,2)
    ) AS ProfitBeforeCampaignCost

FROM ChannelOrders CO

INNER JOIN Channels C
    ON CO.ChannelID = C.ChannelID

GROUP BY C.ChannelName

ORDER BY ProductNetRevenue DESC;
GO


/*====================================================================
 QUERY 4: PROMOTION WITH THE HIGHEST REVENUE
====================================================================*/

SELECT
    P.PromotionID,
    P.PromotionName,
    P.PromotionType,
    P.CustomerDiscountPercent,
    P.PlatformSubsidyPercent,

    COUNT(DISTINCT O.OrderID) AS TotalOrders,

    SUM(OD.Quantity) AS TotalUnitsSold,

    CAST
    (
        SUM
        (
            OD.Quantity * OD.UnitPrice
            - OD.CustomerDiscountAmount
            + OD.PlatformSubsidyAmount
        )
        AS DECIMAL(14,2)
    ) AS NetRevenue

FROM Promotions P

INNER JOIN OrderDetails OD
    ON P.PromotionID = OD.PromotionID

INNER JOIN Orders O
    ON OD.OrderID = O.OrderID

WHERE O.OrderStatus = N'Completed'
  AND O.CampaignID = 1

GROUP BY
    P.PromotionID,
    P.PromotionName,
    P.PromotionType,
    P.CustomerDiscountPercent,
    P.PlatformSubsidyPercent

ORDER BY NetRevenue DESC;
GO


/*====================================================================
 QUERY 5: PROMOTION WITH THE HIGHEST PROFIT

 Variable order-level costs are allocated to product lines based on
 each line's share of order product revenue.

 Fixed campaign costs are NOT allocated to individual promotions.
====================================================================*/

WITH OrderTotals AS
(
    SELECT
        O.OrderID,

        SUM
        (
            OD.Quantity * OD.UnitPrice
            - OD.CustomerDiscountAmount
            + OD.PlatformSubsidyAmount
        ) AS OrderProductRevenue,

        O.PlatformFee,
        O.ShippingSubsidy,
        O.ShippingFeePaidByCustomer

    FROM Orders O

    INNER JOIN OrderDetails OD
        ON O.OrderID = OD.OrderID

    WHERE O.OrderStatus = N'Completed'
      AND O.CampaignID = 1

    GROUP BY
        O.OrderID,
        O.PlatformFee,
        O.ShippingSubsidy,
        O.ShippingFeePaidByCustomer
),

LineProfit AS
(
    SELECT
        OD.OrderDetailID,
        OD.PromotionID,

        (
            OD.Quantity * OD.UnitPrice
            - OD.CustomerDiscountAmount
            + OD.PlatformSubsidyAmount
        ) AS LineNetRevenue,

        OD.CostOfGoodsSold,
        OD.GiftCost,

        (
            (
                OD.Quantity * OD.UnitPrice
                - OD.CustomerDiscountAmount
                + OD.PlatformSubsidyAmount
            )
            / NULLIF(OT.OrderProductRevenue, 0)
        )
        * OT.PlatformFee
        AS AllocatedPlatformFee,

        (
            (
                OD.Quantity * OD.UnitPrice
                - OD.CustomerDiscountAmount
                + OD.PlatformSubsidyAmount
            )
            / NULLIF(OT.OrderProductRevenue, 0)
        )
        * OT.ShippingSubsidy
        AS AllocatedShippingSubsidy,

        (
            (
                OD.Quantity * OD.UnitPrice
                - OD.CustomerDiscountAmount
                + OD.PlatformSubsidyAmount
            )
            / NULLIF(OT.OrderProductRevenue, 0)
        )
        * OT.ShippingFeePaidByCustomer
        AS AllocatedShippingRevenue

    FROM OrderDetails OD

    INNER JOIN OrderTotals OT
        ON OD.OrderID = OT.OrderID
)

SELECT
    P.PromotionID,
    P.PromotionName,

    CAST
    (
        SUM(LP.LineNetRevenue)
        AS DECIMAL(14,2)
    ) AS NetRevenue,

    CAST
    (
        SUM
        (
            LP.LineNetRevenue
            - LP.CostOfGoodsSold
            - LP.GiftCost
            - LP.AllocatedPlatformFee
            - LP.AllocatedShippingSubsidy
            + LP.AllocatedShippingRevenue
        )
        AS DECIMAL(14,2)
    ) AS PromotionProfit,

    CAST
    (
        SUM
        (
            LP.LineNetRevenue
            - LP.CostOfGoodsSold
            - LP.GiftCost
            - LP.AllocatedPlatformFee
            - LP.AllocatedShippingSubsidy
            + LP.AllocatedShippingRevenue
        )
        * 100.0
        / NULLIF(SUM(LP.LineNetRevenue),0)

        AS DECIMAL(10,2)
    ) AS PromotionProfitMarginPercent

FROM LineProfit LP

INNER JOIN Promotions P
    ON LP.PromotionID = P.PromotionID

GROUP BY
    P.PromotionID,
    P.PromotionName

ORDER BY PromotionProfit DESC;
GO


/*====================================================================
 QUERY 6: LIVESTREAM WITH THE HIGHEST CONVERSION RATE

 View-to-order conversion rate =
 Completed orders attributed to livestream
 / Total livestream views * 100
====================================================================*/

SELECT
    L.LivestreamID,
    L.LiveDate,
    C.ChannelName,
    L.HostName,
    L.TotalViews,
    L.TotalClicks,

    COUNT(DISTINCT O.OrderID) AS CompletedOrders,

    CAST
    (
        COUNT(DISTINCT O.OrderID)
        * 100.0
        / NULLIF(L.TotalViews,0)

        AS DECIMAL(10,4)
    ) AS ViewToOrderConversionRatePercent,

    CAST
    (
        COUNT(DISTINCT O.OrderID)
        * 100.0
        / NULLIF(L.TotalClicks,0)

        AS DECIMAL(10,2)
    ) AS ClickToOrderConversionRatePercent

FROM Livestreams L

INNER JOIN Channels C
    ON L.ChannelID = C.ChannelID

LEFT JOIN Orders O
    ON L.LivestreamID = O.LivestreamID
   AND O.OrderStatus = N'Completed'

GROUP BY
    L.LivestreamID,
    L.LiveDate,
    C.ChannelName,
    L.HostName,
    L.TotalViews,
    L.TotalClicks

ORDER BY
    ViewToOrderConversionRatePercent DESC;
GO


/*====================================================================
 QUERY 7: PERCENTAGE OF NEW CUSTOMERS

 Definition:
 A new customer registered during the campaign and placed at least
 one completed campaign order.
====================================================================*/

WITH CampaignCustomers AS
(
    SELECT DISTINCT
        C.CustomerID,
        C.RegisterDate

    FROM Customers C

    INNER JOIN Orders O
        ON C.CustomerID = O.CustomerID

    WHERE O.OrderStatus = N'Completed'
      AND O.CampaignID = 1
)

SELECT
    COUNT(*) AS TotalPurchasingCustomers,

    SUM
    (
        CASE
            WHEN CC.RegisterDate BETWEEN CA.StartDate AND CA.EndDate
            THEN 1
            ELSE 0
        END
    ) AS NewCustomers,

    CAST
    (
        SUM
        (
            CASE
                WHEN CC.RegisterDate BETWEEN CA.StartDate AND CA.EndDate
                THEN 1
                ELSE 0
            END
        )
        * 100.0
        / NULLIF(COUNT(*),0)

        AS DECIMAL(10,2)
    ) AS NewCustomerPercent

FROM CampaignCustomers CC

CROSS JOIN Campaigns CA

WHERE CA.CampaignID = 1

GROUP BY
    CA.StartDate,
    CA.EndDate;
GO


/*====================================================================
 QUERY 8: ROI BY SALES CHANNEL

 Channel ROI =
 Net Channel Profit
 / Total Channel Campaign Cost
 * 100

 Direct campaign costs:
 Assigned directly using CampaignCosts.ChannelID.

 Shared campaign costs:
 Allocated based on each channel's share of total campaign revenue.

 Livestream costs:
 Assigned directly to the corresponding channel.
====================================================================*/

WITH OrderEconomics AS
(
    SELECT
        O.OrderID,
        O.ChannelID,

        SUM
        (
            OD.Quantity * OD.UnitPrice
            - OD.CustomerDiscountAmount
            + OD.PlatformSubsidyAmount
        )
        + O.ShippingFeePaidByCustomer
        AS TotalRevenue,

        SUM(OD.CostOfGoodsSold) AS COGS,

        SUM(OD.GiftCost) AS GiftCost,

        O.PlatformFee,
        O.ShippingSubsidy,

        SUM
        (
            OD.Quantity * OD.UnitPrice
            - OD.CustomerDiscountAmount
            + OD.PlatformSubsidyAmount
            - OD.CostOfGoodsSold
            - OD.GiftCost
        )
        - O.PlatformFee
        - O.ShippingSubsidy
        + O.ShippingFeePaidByCustomer
        AS ProfitBeforeCampaignCost

    FROM Orders O

    INNER JOIN OrderDetails OD
        ON O.OrderID = OD.OrderID

    WHERE O.OrderStatus = N'Completed'
      AND O.CampaignID = 1

    GROUP BY
        O.OrderID,
        O.ChannelID,
        O.PlatformFee,
        O.ShippingSubsidy,
        O.ShippingFeePaidByCustomer
),

ChannelPerformance AS
(
    SELECT
        ChannelID,

        SUM(TotalRevenue) AS ChannelRevenue,

        SUM(COGS) AS ChannelCOGS,

        SUM(GiftCost) AS ChannelGiftCost,

        SUM(PlatformFee) AS ChannelPlatformFee,

        SUM(ShippingSubsidy) AS ChannelShippingSubsidy,

        SUM(ProfitBeforeCampaignCost)
        AS ChannelProfitBeforeCampaignCost

    FROM OrderEconomics

    GROUP BY ChannelID
),

CampaignRevenue AS
(
    SELECT
        SUM(ChannelRevenue) AS TotalCampaignRevenue

    FROM ChannelPerformance
),

SharedCampaignCost AS
(
    SELECT
        ISNULL(SUM(Amount),0) AS TotalSharedCampaignCost

    FROM CampaignCosts

    WHERE CampaignID = 1
      AND ChannelID IS NULL
),

DirectChannelCost AS
(
    SELECT
        ChannelID,
        SUM(Amount) AS DirectCampaignCost

    FROM CampaignCosts

    WHERE CampaignID = 1
      AND ChannelID IS NOT NULL

    GROUP BY ChannelID
),

ChannelLivestreamCost AS
(
    SELECT
        ChannelID,
        SUM(LivestreamCost) AS LivestreamCost

    FROM Livestreams

    WHERE CampaignID = 1

    GROUP BY ChannelID
)

SELECT
    C.ChannelName,

    CAST
    (
        CP.ChannelRevenue
        AS DECIMAL(14,2)
    ) AS ChannelRevenue,

    CAST
    (
        CP.ChannelCOGS
        AS DECIMAL(14,2)
    ) AS COGS,

    CAST
    (
        CP.ChannelGiftCost
        AS DECIMAL(14,2)
    ) AS GiftCost,

    CAST
    (
        CP.ChannelPlatformFee
        AS DECIMAL(14,2)
    ) AS PlatformFee,

    CAST
    (
        CP.ChannelShippingSubsidy
        AS DECIMAL(14,2)
    ) AS ShippingSubsidy,

    CAST
    (
        CP.ChannelProfitBeforeCampaignCost
        AS DECIMAL(14,2)
    ) AS ProfitBeforeCampaignCost,

    CAST
    (
        CP.ChannelRevenue
        * 100.0
        / NULLIF(CR.TotalCampaignRevenue,0)

        AS DECIMAL(10,2)
    ) AS RevenueSharePercent,

    CAST
    (
        ISNULL(DCC.DirectCampaignCost,0)
        AS DECIMAL(14,2)
    ) AS DirectCampaignCost,

    CAST
    (
        SCC.TotalSharedCampaignCost
        * CP.ChannelRevenue
        / NULLIF(CR.TotalCampaignRevenue,0)

        AS DECIMAL(14,2)
    ) AS AllocatedSharedCampaignCost,

    CAST
    (
        ISNULL(CLC.LivestreamCost,0)
        AS DECIMAL(14,2)
    ) AS LivestreamCost,

    CAST
    (
        ISNULL(DCC.DirectCampaignCost,0)

        +

        (
            SCC.TotalSharedCampaignCost
            * CP.ChannelRevenue
            / NULLIF(CR.TotalCampaignRevenue,0)
        )

        +

        ISNULL(CLC.LivestreamCost,0)

        AS DECIMAL(14,2)
    ) AS TotalChannelCampaignCost,

    CAST
    (
        CP.ChannelProfitBeforeCampaignCost

        -

        ISNULL(DCC.DirectCampaignCost,0)

        -

        (
            SCC.TotalSharedCampaignCost
            * CP.ChannelRevenue
            / NULLIF(CR.TotalCampaignRevenue,0)
        )

        -

        ISNULL(CLC.LivestreamCost,0)

        AS DECIMAL(14,2)
    ) AS NetChannelProfit,

    CAST
    (
        (
            CP.ChannelProfitBeforeCampaignCost

            -

            ISNULL(DCC.DirectCampaignCost,0)

            -

            (
                SCC.TotalSharedCampaignCost
                * CP.ChannelRevenue
                / NULLIF(CR.TotalCampaignRevenue,0)
            )

            -

            ISNULL(CLC.LivestreamCost,0)
        )

        * 100.0

        /

        NULLIF
        (
            ISNULL(DCC.DirectCampaignCost,0)

            +

            (
                SCC.TotalSharedCampaignCost
                * CP.ChannelRevenue
                / NULLIF(CR.TotalCampaignRevenue,0)
            )

            +

            ISNULL(CLC.LivestreamCost,0),

            0
        )

        AS DECIMAL(10,2)
    ) AS ROI_Percent

FROM ChannelPerformance CP

INNER JOIN Channels C
    ON CP.ChannelID = C.ChannelID

CROSS JOIN CampaignRevenue CR

CROSS JOIN SharedCampaignCost SCC

LEFT JOIN DirectChannelCost DCC
    ON CP.ChannelID = DCC.ChannelID

LEFT JOIN ChannelLivestreamCost CLC
    ON CP.ChannelID = CLC.ChannelID

ORDER BY ROI_Percent DESC;
GO


/*====================================================================
 QUERY 9: TOP 20 CUSTOMERS BY SPENDING
====================================================================*/

SELECT TOP 20
    C.CustomerID,
    C.CustomerName,
    C.StateName,
    C.CustomerSegment,

    COUNT(DISTINCT O.OrderID) AS TotalOrders,

    CAST
    (
        SUM
        (
            OD.Quantity * OD.UnitPrice
            - OD.CustomerDiscountAmount
            + OD.PlatformSubsidyAmount
        )
        AS DECIMAL(14,2)
    ) AS TotalProductSpending,

    SUM(OD.Quantity) AS TotalUnitsPurchased

FROM Customers C

INNER JOIN Orders O
    ON C.CustomerID = O.CustomerID

INNER JOIN OrderDetails OD
    ON O.OrderID = OD.OrderID

WHERE O.OrderStatus = N'Completed'
  AND O.CampaignID = 1

GROUP BY
    C.CustomerID,
    C.CustomerName,
    C.StateName,
    C.CustomerSegment

ORDER BY TotalProductSpending DESC;
GO


/*====================================================================
 QUERY 10: PROFIT MARGIN BY PRODUCT

 Product-level variable costs include:
 - COGS
 - Gift cost
 - Allocated platform fee
 - Allocated shipping subsidy
 - Allocated shipping revenue

 Fixed campaign costs are NOT allocated to individual products.
====================================================================*/

WITH OrderTotals AS
(
    SELECT
        O.OrderID,

        SUM
        (
            OD.Quantity * OD.UnitPrice
            - OD.CustomerDiscountAmount
            + OD.PlatformSubsidyAmount
        ) AS OrderProductRevenue,

        O.PlatformFee,
        O.ShippingSubsidy,
        O.ShippingFeePaidByCustomer

    FROM Orders O

    INNER JOIN OrderDetails OD
        ON O.OrderID = OD.OrderID

    WHERE O.OrderStatus = N'Completed'
      AND O.CampaignID = 1

    GROUP BY
        O.OrderID,
        O.PlatformFee,
        O.ShippingSubsidy,
        O.ShippingFeePaidByCustomer
),

ProductLineProfit AS
(
    SELECT
        OD.ProductID,
        OD.Quantity,

        (
            OD.Quantity * OD.UnitPrice
            - OD.CustomerDiscountAmount
            + OD.PlatformSubsidyAmount
        ) AS LineNetRevenue,

        OD.CostOfGoodsSold,
        OD.GiftCost,

        (
            (
                OD.Quantity * OD.UnitPrice
                - OD.CustomerDiscountAmount
                + OD.PlatformSubsidyAmount
            )
            / NULLIF(OT.OrderProductRevenue,0)
        )
        * OT.PlatformFee
        AS AllocatedPlatformFee,

        (
            (
                OD.Quantity * OD.UnitPrice
                - OD.CustomerDiscountAmount
                + OD.PlatformSubsidyAmount
            )
            / NULLIF(OT.OrderProductRevenue,0)
        )
        * OT.ShippingSubsidy
        AS AllocatedShippingSubsidy,

        (
            (
                OD.Quantity * OD.UnitPrice
                - OD.CustomerDiscountAmount
                + OD.PlatformSubsidyAmount
            )
            / NULLIF(OT.OrderProductRevenue,0)
        )
        * OT.ShippingFeePaidByCustomer
        AS AllocatedShippingRevenue

    FROM OrderDetails OD

    INNER JOIN OrderTotals OT
        ON OD.OrderID = OT.OrderID
)

SELECT
    P.ProductID,
    P.ProductName,
    P.BrandName,
    C.CategoryName,

    SUM(PLP.Quantity) AS TotalUnitsSold,

    CAST
    (
        SUM(PLP.LineNetRevenue)
        AS DECIMAL(14,2)
    ) AS NetRevenue,

    CAST
    (
        SUM(PLP.CostOfGoodsSold)
        AS DECIMAL(14,2)
    ) AS TotalCOGS,

    CAST
    (
        SUM(PLP.GiftCost)
        AS DECIMAL(14,2)
    ) AS TotalGiftCost,

    CAST
    (
        SUM(PLP.AllocatedPlatformFee)
        AS DECIMAL(14,2)
    ) AS AllocatedPlatformFee,

    CAST
    (
        SUM
        (
            PLP.LineNetRevenue
            - PLP.CostOfGoodsSold
            - PLP.GiftCost
            - PLP.AllocatedPlatformFee
            - PLP.AllocatedShippingSubsidy
            + PLP.AllocatedShippingRevenue
        )
        AS DECIMAL(14,2)
    ) AS ProductProfit,

    CAST
    (
        SUM
        (
            PLP.LineNetRevenue
            - PLP.CostOfGoodsSold
            - PLP.GiftCost
            - PLP.AllocatedPlatformFee
            - PLP.AllocatedShippingSubsidy
            + PLP.AllocatedShippingRevenue
        )

        * 100.0

        / NULLIF(SUM(PLP.LineNetRevenue),0)

        AS DECIMAL(10,2)
    ) AS ProfitMarginPercent

FROM ProductLineProfit PLP

INNER JOIN Products P
    ON PLP.ProductID = P.ProductID

INNER JOIN Categories C
    ON P.CategoryID = C.CategoryID

GROUP BY
    P.ProductID,
    P.ProductName,
    P.BrandName,
    C.CategoryName

ORDER BY ProfitMarginPercent DESC;
GO


/*====================================================================
 OPTIONAL FINAL CHECK:
 TOTAL CAMPAIGN PROFITABILITY
====================================================================*/

WITH OrderEconomics AS
(
    SELECT
        O.OrderID,

        SUM
        (
            OD.Quantity * OD.UnitPrice
            - OD.CustomerDiscountAmount
            + OD.PlatformSubsidyAmount
        )
        + O.ShippingFeePaidByCustomer
        AS TotalRevenue,

        SUM
        (
            OD.Quantity * OD.UnitPrice
            - OD.CustomerDiscountAmount
            + OD.PlatformSubsidyAmount
            - OD.CostOfGoodsSold
            - OD.GiftCost
        )
        - O.PlatformFee
        - O.ShippingSubsidy
        + O.ShippingFeePaidByCustomer
        AS ProfitBeforeCampaignCost

    FROM Orders O

    INNER JOIN OrderDetails OD
        ON O.OrderID = OD.OrderID

    WHERE O.OrderStatus = N'Completed'
      AND O.CampaignID = 1

    GROUP BY
        O.OrderID,
        O.PlatformFee,
        O.ShippingSubsidy,
        O.ShippingFeePaidByCustomer
),

CampaignInvestment AS
(
    SELECT

        (
            SELECT ISNULL(SUM(Amount),0)
            FROM CampaignCosts
            WHERE CampaignID = 1
        )

        +

        (
            SELECT ISNULL(SUM(LivestreamCost),0)
            FROM Livestreams
            WHERE CampaignID = 1
        )

        AS TotalCampaignInvestment
)

SELECT
    CAST
    (
        SUM(OE.TotalRevenue)
        AS DECIMAL(14,2)
    ) AS TotalCampaignRevenue,

    CAST
    (
        SUM(OE.ProfitBeforeCampaignCost)
        AS DECIMAL(14,2)
    ) AS ProfitBeforeCampaignCost,

    CAST
    (
        CI.TotalCampaignInvestment
        AS DECIMAL(14,2)
    ) AS TotalCampaignInvestment,

    CAST
    (
        SUM(OE.ProfitBeforeCampaignCost)
        - CI.TotalCampaignInvestment
        AS DECIMAL(14,2)
    ) AS NetCampaignProfit,

    CAST
    (
        (
            SUM(OE.ProfitBeforeCampaignCost)
            - CI.TotalCampaignInvestment
        )
        * 100.0
        / NULLIF(CI.TotalCampaignInvestment,0)

        AS DECIMAL(10,2)
    ) AS TotalCampaignROI_Percent

FROM OrderEconomics OE

CROSS JOIN CampaignInvestment CI

GROUP BY CI.TotalCampaignInvestment;
GO
