/*====================================================================
 PART 5: GENERATE 600 ORDERS

 Design:
 - TikTok Shop receives about 60% of orders.
 - Shopee receives about 40%.
 - Channel assignment is independent from promotion assignment.
 - Aug 8 has stronger livestream attribution than Aug 7 and Aug 9.
 - A small percentage of orders are cancelled or returned.
====================================================================*/

DECLARE @OrderNumber INT = 1;
DECLARE @CustomerID INT;
DECLARE @ChannelID INT;
DECLARE @LivestreamID INT;
DECLARE @OrderDate DATE;
DECLARE @OrderDateTime DATETIME2(0);
DECLARE @OrderStatus NVARCHAR(30);
DECLARE @PaymentMethod NVARCHAR(50);
DECLARE @ShippingFee DECIMAL(12,2);
DECLARE @ShippingSubsidy DECIMAL(12,2);
DECLARE @Hour INT;
DECLARE @Minute INT;
DECLARE @LiveThreshold INT;

WHILE @OrderNumber <= 600
BEGIN
    /* Cycle evenly through 60 customers */
    SET @CustomerID = ((@OrderNumber * 17) % 60) + 1;

    /* Approximately 60% TikTok Shop, 40% Shopee */
    SET @ChannelID =
        CASE
            WHEN @OrderNumber % 5 IN (0,1,2) THEN 2
            ELSE 1
        END;

    /* Campaign runs for 3 days */
    SET @OrderDate =
        DATEADD
        (
            DAY,
            (@OrderNumber - 1) % 3,
            CAST('2025-08-07' AS DATE)
        );

    /*
       Livestream attribution:
       Aug 7: about 60%
       Aug 8: about 90%
       Aug 9: about 70%
    */
    SET @LiveThreshold =
        CASE
            WHEN @OrderDate = '2025-08-07' THEN 6
            WHEN @OrderDate = '2025-08-08' THEN 9
            ELSE 7
        END;

    IF @OrderNumber % 10 < @LiveThreshold
    BEGIN
        SET @LivestreamID =
            CASE
                WHEN @OrderDate = '2025-08-07' AND @ChannelID = 1 THEN 1
                WHEN @OrderDate = '2025-08-07' AND @ChannelID = 2 THEN 2
                WHEN @OrderDate = '2025-08-08' AND @ChannelID = 1 THEN 3
                WHEN @OrderDate = '2025-08-08' AND @ChannelID = 2 THEN 4
                WHEN @OrderDate = '2025-08-09' AND @ChannelID = 1 THEN 5
                WHEN @OrderDate = '2025-08-09' AND @ChannelID = 2 THEN 6
            END;

        SET @Hour = 19 + (@OrderNumber % 3);
    END
    ELSE
    BEGIN
        SET @LivestreamID = NULL;
        SET @Hour = 9 + (@OrderNumber % 10);
    END;

    SET @Minute = (@OrderNumber * 7) % 60;

    SET @OrderDateTime =
        DATEADD
        (
            MINUTE,
            @Minute,
            DATEADD(HOUR, @Hour, CAST(@OrderDate AS DATETIME2))
        );

    /* Approximately 95% of orders are completed */
    SET @OrderStatus =
        CASE
            WHEN @OrderNumber % 41 = 0 THEN N'Cancelled'
            WHEN @OrderNumber % 53 = 0 THEN N'Returned'
            ELSE N'Completed'
        END;

    SET @PaymentMethod =
        CASE @OrderNumber % 4
            WHEN 0 THEN N'Credit Card'
            WHEN 1 THEN N'Digital Wallet'
            WHEN 2 THEN N'Cash on Delivery'
            ELSE N'Bank Transfer'
        END;

    SET @ShippingFee =
        CASE
            WHEN @OrderNumber % 3 = 0 THEN 0.00
            ELSE 3.99
        END;

    SET @ShippingSubsidy =
        CASE
            WHEN @ShippingFee = 0 THEN 3.99
            ELSE 1.50
        END;

    INSERT INTO Orders
    (
        OrderID,
        CustomerID,
        ChannelID,
        CampaignID,
        LivestreamID,
        OrderDateTime,
        OrderStatus,
        PaymentMethod,
        ShippingFeePaidByCustomer,
        ShippingSubsidy,
        PlatformFee
    )
    VALUES
    (
        10000 + @OrderNumber,
        @CustomerID,
        @ChannelID,
        1,
        @LivestreamID,
        @OrderDateTime,
        @OrderStatus,
        @PaymentMethod,
        @ShippingFee,
        @ShippingSubsidy,
        0.00
    );

    SET @OrderNumber += 1;
END;
GO


/*====================================================================
 PART 6: GENERATE ORDER DETAILS

 - Every order has at least one product.
 - About 45% of orders contain a second product.
 - Promotions are assigned at PRODUCT LINE level.
 - Promotion assignment is independent from ChannelID.
====================================================================*/

DECLARE @CurrentOrderID INT = 10001;
DECLARE @OrderSequence INT;
DECLARE @LineNumber INT;
DECLARE @ProductID INT;
DECLARE @SecondProductID INT;
DECLARE @PromotionID INT;
DECLARE @PromoSeed INT;
DECLARE @Quantity INT;
DECLARE @UnitPrice DECIMAL(12,2);
DECLARE @CostPrice DECIMAL(12,2);
DECLARE @CustomerDiscountPercent DECIMAL(5,2);
DECLARE @PlatformSubsidyPercent DECIMAL(5,2);
DECLARE @GiftUnitCost DECIMAL(12,2);
DECLARE @CustomerDiscountAmount DECIMAL(12,2);
DECLARE @PlatformSubsidyAmount DECIMAL(12,2);

WHILE @CurrentOrderID <= 10600
BEGIN
    SET @OrderSequence = @CurrentOrderID - 10000;

    /*------------------------------
      FIRST PRODUCT LINE
    ------------------------------*/

    SET @LineNumber = 1;

    SET @ProductID =
        101 + ((@OrderSequence * 11) % 24);

    SET @Quantity =
        CASE
            WHEN @OrderSequence % 13 = 0 THEN 2
            ELSE 1
        END;

    /*
       Promotion mix:
       - 5%  : 50% flash sale
       - 10% : 30% flash sale
       - 20% : 20% discount
       - 25% : 10% discount
       - 15% : phone stand gift
       - 5%  : mini earbuds gift
       - 20% : no promotion
    */
    SET @PromoSeed =
        (@CurrentOrderID * 7 + @LineNumber * 3) % 20;

    SET @PromotionID =
        CASE
            WHEN @PromoSeed = 0 THEN 4
            WHEN @PromoSeed IN (1,2) THEN 3
            WHEN @PromoSeed IN (3,4,5,6) THEN 2
            WHEN @PromoSeed IN (7,8,9,10,11) THEN 1
            WHEN @PromoSeed IN (12,13,14) THEN 5
            WHEN @PromoSeed = 15 THEN 6
            ELSE NULL
        END;

    SELECT
        @UnitPrice = RegularPrice,
        @CostPrice = CostPrice
    FROM Products
    WHERE ProductID = @ProductID;

    IF @PromotionID IS NULL
    BEGIN
        SET @CustomerDiscountPercent = 0;
        SET @PlatformSubsidyPercent = 0;
        SET @GiftUnitCost = 0;
    END
    ELSE
    BEGIN
        SELECT
            @CustomerDiscountPercent = CustomerDiscountPercent,
            @PlatformSubsidyPercent = PlatformSubsidyPercent,
            @GiftUnitCost = GiftUnitCost
        FROM Promotions
        WHERE PromotionID = @PromotionID;
    END;

    SET @CustomerDiscountAmount =
        ROUND
        (
            @Quantity
            * @UnitPrice
            * @CustomerDiscountPercent / 100.0,
            2
        );

    SET @PlatformSubsidyAmount =
        ROUND
        (
            @Quantity
            * @UnitPrice
            * @PlatformSubsidyPercent / 100.0,
            2
        );

    INSERT INTO OrderDetails
    (
        OrderID,
        ProductID,
        PromotionID,
        Quantity,
        UnitPrice,
        CustomerDiscountAmount,
        PlatformSubsidyAmount,
        CostOfGoodsSold,
        GiftCost
    )
    VALUES
    (
        @CurrentOrderID,
        @ProductID,
        @PromotionID,
        @Quantity,
        @UnitPrice,
        @CustomerDiscountAmount,
        @PlatformSubsidyAmount,
        @CostPrice * @Quantity,
        @GiftUnitCost
    );


    /*------------------------------
      SECOND PRODUCT LINE
      About 45% of orders
    ------------------------------*/

    IF @OrderSequence % 20 < 9
    BEGIN
        SET @LineNumber = 2;

        SET @SecondProductID =
            101 + ((@OrderSequence * 5 + 7) % 24);

        IF @SecondProductID = @ProductID
        BEGIN
            SET @SecondProductID =
                CASE
                    WHEN @SecondProductID = 124 THEN 101
                    ELSE @SecondProductID + 1
                END;
        END;

        SET @Quantity = 1;

        SET @PromoSeed =
            (@CurrentOrderID * 7 + @LineNumber * 3) % 20;

        SET @PromotionID =
            CASE
                WHEN @PromoSeed = 0 THEN 4
                WHEN @PromoSeed IN (1,2) THEN 3
                WHEN @PromoSeed IN (3,4,5,6) THEN 2
                WHEN @PromoSeed IN (7,8,9,10,11) THEN 1
                WHEN @PromoSeed IN (12,13,14) THEN 5
                WHEN @PromoSeed = 15 THEN 6
                ELSE NULL
            END;

        SELECT
            @UnitPrice = RegularPrice,
            @CostPrice = CostPrice
        FROM Products
        WHERE ProductID = @SecondProductID;

        IF @PromotionID IS NULL
        BEGIN
            SET @CustomerDiscountPercent = 0;
            SET @PlatformSubsidyPercent = 0;
            SET @GiftUnitCost = 0;
        END
        ELSE
        BEGIN
            SELECT
                @CustomerDiscountPercent = CustomerDiscountPercent,
                @PlatformSubsidyPercent = PlatformSubsidyPercent,
                @GiftUnitCost = GiftUnitCost
            FROM Promotions
            WHERE PromotionID = @PromotionID;
        END;

        SET @CustomerDiscountAmount =
            ROUND
            (
                @UnitPrice
                * @CustomerDiscountPercent / 100.0,
                2
            );

        SET @PlatformSubsidyAmount =
            ROUND
            (
                @UnitPrice
                * @PlatformSubsidyPercent / 100.0,
                2
            );

        INSERT INTO OrderDetails
        (
            OrderID,
            ProductID,
            PromotionID,
            Quantity,
            UnitPrice,
            CustomerDiscountAmount,
            PlatformSubsidyAmount,
            CostOfGoodsSold,
            GiftCost
        )
        VALUES
        (
            @CurrentOrderID,
            @SecondProductID,
            @PromotionID,
            1,
            @UnitPrice,
            @CustomerDiscountAmount,
            @PlatformSubsidyAmount,
            @CostPrice,
            @GiftUnitCost
        );
    END;

    SET @CurrentOrderID += 1;
END;
GO


/*====================================================================
 PART 7: CALCULATE PLATFORM FEES

 Marketplace commission is calculated on product revenue received
 by the seller after customer discounts and platform subsidies.

 NetProductRevenue =
 GrossRevenue
 - CustomerDiscountAmount
 + PlatformSubsidyAmount
====================================================================*/

UPDATE O
SET O.PlatformFee =
    ROUND
    (
        X.NetProductRevenue
        * C.CommissionRate / 100.0,
        2
    )
FROM Orders O

INNER JOIN Channels C
    ON O.ChannelID = C.ChannelID

INNER JOIN
(
    SELECT
        OrderID,
        SUM
        (
            Quantity * UnitPrice
            - CustomerDiscountAmount
            + PlatformSubsidyAmount
        ) AS NetProductRevenue
    FROM OrderDetails
    GROUP BY OrderID
) X
    ON O.OrderID = X.OrderID

WHERE O.CampaignID = 1;
GO


